{
  "name": "anivault-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:schema": "wrangler d1 execute anivault --file=./d1_schema.sql",
    "db:data": "wrangler d1 execute anivault --file=./d1_data.sql",
    "db:sessions": "wrangler d1 execute anivault --file=./d1_sessions.sql",
    "db:push-tokens": "wrangler d1 execute anivault --file=./migrations/0001_push_tokens.sql",
    "db:bug-reports": "wrangler d1 execute anivault --file=./migrations/0003_bug_reports.sql",
    "db:art-cache": "wrangler d1 execute anivault --remote --file=./migrations/0007_scraper_art_cache.sql",
    "discord:pc": "node tools/discord-rpc-bridge.mjs",
    "db:homepage-cache": "wrangler d1 execute anivault --remote --file=./migrations/0008_homepage_cache.sql"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4",
    "bcryptjs": "^2.4.3",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/bcryptjs": "^2.4.6",
    "typescript": "^5.7.2",
    "wrangler": "^3.90.0"
  }
}
